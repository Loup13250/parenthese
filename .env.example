# ================================================
# CONFIGURATION — LA PARENTHÈSE HARMONIEUSE
# ================================================

# Base de données Turso (à copier dans Vercel -> Project Settings -> Environment Variables) :
TURSO_DATABASE_URL=libsql://votre-base-nom-organisation.turso.io
TURSO_AUTH_TOKEN=votre_token_secret_turso

# Email de réception des demandes de contact :
NOTIFY_EMAIL=contact@votre-domaine.fr

# Configuration SMTP (Optionnel - pour envoi d'emails réels via Nodemailer) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-adresse@gmail.com
SMTP_PASS=votre_mot_de_passe_application_google

# Espace administration privé :
# URL : /admin
# Identifiant par défaut : admin

